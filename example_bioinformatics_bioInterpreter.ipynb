# BiologicalInterpreter Example Notebook
# This notebook demonstrates how to use the BiologicalInterpreter class for pathway analysis

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from bioinformatics_biointerpreter import BiologicalInterpreter
import os

# Create data directory if it doesn't exist
if not os.path.exists('./data'):
    os.makedirs('./data')

# Create output directories
for directory in ['./reports', './exports', './figures']:
    if not os.path.exists(directory):
        os.makedirs(directory)

# 1. Initialize the BiologicalInterpreter
print("Initializing BiologicalInterpreter...")
bio_interp = BiologicalInterpreter(organism="human", data_dir="./data")

# 2. Load Example Data
# In a real-world scenario, this would be your differential expression results
# from RNA-seq, proteomics, or other omics data analysis

# Let's create some mock differential expression data
print("Loading sample data...")

# Gene IDs - normally these would be Entrez IDs, Ensembl IDs, or other standard identifiers
gene_ids = [
    "3101", "3098", "3099", "4967", "4968", "1737", "1738",  # Some glycolysis and TCA cycle genes
    "1432", "5594", "5595", "6416", "2821",                  # Some signaling pathway genes
    "5925", "5914", "3251", "8243", "1978",                  # Random genes
    "6696", "5337", "5578", "5580", "5581"                   # More random genes
]

# Log2 fold changes - positive values mean upregulated, negative means downregulated
log2fc = [
    2.5, 1.8, 2.1, -1.5, -1.2, -0.8, -1.9,  # First group
    0.5, 1.2, 0.3, 1.6, 2.2,               # Second group
    -0.3, 0.2, -0.1, 0.4, 0.7,             # Third group
    -2.1, -1.8, 1.9, 2.3, 2.8               # Fourth group
]

# P-values from statistical testing
pvalues = [
    0.001, 0.005, 0.002, 0.01, 0.03, 0.04, 0.005,  # First group
    0.2, 0.01, 0.3, 0.007, 0.001,                 # Second group
    0.7, 0.5, 0.9, 0.1, 0.08,                     # Third group
    0.003, 0.009, 0.002, 0.001, 0.0005             # Fourth group
]

# Create a dataframe with the data
de_results = pd.DataFrame({
    'gene_id': gene_ids,
    'log2fc': log2fc,
    'pvalue': pvalues
})

# Calculate adjusted p-values (using Benjamini-Hochberg method)
from scipy.stats import rankdata
de_results['rank'] = rankdata(de_results['pvalue'])
de_results['padj'] = de_results['pvalue'] * len(de_results) / de_results['rank']
de_results['padj'] = de_results['padj'].clip(upper=1)

print("Sample data:")
print(de_results.head())

# 3. Basic Exploration
# Let's see the distribution of fold changes and p-values

plt.figure(figsize=(12, 5))

# Fold change distribution
plt.subplot(1, 2, 1)
sns.histplot(de_results['log2fc'], bins=10, kde=True)
plt.axvline(x=0, color='red', linestyle='--')
plt.title('Distribution of Log2 Fold Changes')
plt.xlabel('Log2 Fold Change')
plt.ylabel('Count')

# P-value distribution
plt.subplot(1, 2, 2)
sns.histplot(de_results['pvalue'], bins=10, kde=True)
plt.axvline(x=0.05, color='red', linestyle='--')
plt.title('Distribution of P-values')
plt.xlabel('P-value')
plt.ylabel('Count')

plt.tight_layout()
plt.savefig('./figures/de_distributions.png', dpi=300)
plt.close()

print("Saved distribution plots to ./figures/de_distributions.png")

# 4. Filter for significant genes
# Typically, we use adjusted p-value < 0.05 and |log2fc| > 1 for significance
significant_genes = de_results[(de_results['padj'] < 0.05) & (abs(de_results['log2fc']) > 1)]['gene_id'].tolist()

print(f"Number of significant genes: {len(significant_genes)}")
print(f"Significant genes: {significant_genes}")

# 5. Run Over-Representation Analysis (ORA) on KEGG pathways
print("\nRunning KEGG pathway enrichment analysis...")
kegg_results = bio_interp.run_enrichment_analysis(
    gene_list=significant_genes,
    source="KEGG",
    method="ora",
    pvalue_cutoff=0.05
)

print("\nKEGG Pathway Enrichment Results:")
if kegg_results.empty:
    print("No significant KEGG pathway enrichment found")
else:
    print(kegg_results)

# 6. Run GO term enrichment (Biological Process)
print("\nRunning GO Biological Process enrichment analysis...")
go_bp_results = bio_interp.run_enrichment_analysis(
    gene_list=significant_genes,
    source="GO",
    category="BP",  # Biological Process
    method="ora",
    pvalue_cutoff=0.05
)

print("\nGO Biological Process Enrichment Results:")
if go_bp_results.empty:
    print("No significant GO BP enrichment found")
else:
    print(go_bp_results)

# 7. Visualize the enrichment results
print("\nCreating visualizations...")

# Barplot visualization
if not kegg_results.empty:
    kegg_fig = bio_interp.visualize_enrichment(
        kegg_results, 
        n_terms=10, 
        plot_type='barplot',
        save_path='./figures/kegg_enrichment_barplot.png'
    )
    print("Saved KEGG enrichment barplot to ./figures/kegg_enrichment_barplot.png")

# Bubble plot visualization
if not go_bp_results.empty:
    go_fig = bio_interp.visualize_enrichment(
        go_bp_results, 
        n_terms=10, 
        plot_type='bubble',
        save_path='./figures/go_enrichment_bubble.png'
    )
    print("Saved GO enrichment bubble plot to ./figures/go_enrichment_bubble.png")

# 8. Run Gene Set Enrichment Analysis (GSEA)
print("\nRunning Gene Set Enrichment Analysis...")

# Create gene scores dictionary (log2fc values)
gene_scores = dict(zip(de_results['gene_id'], de_results['log2fc']))

gsea_results = bio_interp.run_gsea(
    gene_scores=gene_scores,
    source="REACTOME",
    permutations=100,  # Use more permutations (e.g. 1000) for publication-quality results
    min_set_size=3,  # Reduced for this example
    max_set_size=500,
    pvalue_cutoff=0.1  # Often GSEA uses a more liberal threshold
)

print("\nGSEA Results for Reactome Pathways:")
if gsea_results.empty:
    print("No significant GSEA results found")
else:
    print(gsea_results)

# Visualize GSEA results
if not gsea_results.empty:
    gsea_fig = bio_interp.visualize_enrichment(
        gsea_results, 
        n_terms=10, 
        plot_type='barplot',
        save_path='./figures/gsea_reactome_barplot.png'
    )
    print("Saved GSEA results barplot to ./figures/gsea_reactome_barplot.png")

# 9. Generate a comprehensive report
print("\nGenerating reports...")

if not kegg_results.empty:
    kegg_report_path = bio_interp.generate_pathway_report(
        results=kegg_results,
        source="KEGG",
        output_dir="./reports",
        include_genes=True,
        include_plots=True
    )
    print(f"KEGG report generated at: {kegg_report_path}")

if not go_bp_results.empty:
    go_report_path = bio_interp.generate_pathway_report(
        results=go_bp_results,
        source="GO",
        output_dir="./reports",
        include_genes=True,
        include_plots=True
    )
    print(f"GO report generated at: {go_report_path}")

# 10. Create a network visualization
print("\nCreating network visualization...")

if not kegg_results.empty:
    network_fig = bio_interp.create_network_visualization(
        results=kegg_results,
        n_terms=5,
        include_genes=True,
        output_path="./figures/kegg_network.png"
    )
    print("Network visualization saved to ./figures/kegg_network.png")

# 11. Export results for downstream analysis
print("\nExporting results...")

if not kegg_results.empty:
    kegg_export_path = bio_interp.export_results(
        results=kegg_results,
        output_path="./exports/kegg_enrichment.csv",
        format="csv"
    )
    print(f"KEGG results exported to: {kegg_export_path}")

if not go_bp_results.empty:
    go_export_path = bio_interp.export_results(
        results=go_bp_results,
        output_path="./exports/go_bp_enrichment.tsv",
        format="tsv"
    )
    print(f"GO results exported to: {go_export_path}")

print("\nAnalysis complete! Check the reports, figures, and exports directories for results.")

# 12. Additional Analysis: Compare up and down-regulated genes separately
print("\nComparing up vs down-regulated genes...")

# Get up and down regulated genes
upregulated_genes = de_results[(de_results['padj'] < 0.05) & (de_results['log2fc'] > 1)]['gene_id'].tolist()
downregulated_genes = de_results[(de_results['padj'] < 0.05) & (de_results['log2fc'] < -1)]['gene_id'].tolist()

print(f"Up-regulated genes: {len(upregulated_genes)}")
print(f"Down-regulated genes: {len(downregulated_genes)}")

# Run enrichment on up-regulated genes
if upregulated_genes:
    up_kegg_results = bio_interp.run_enrichment_analysis(
        gene_list=upregulated_genes,
        source="KEGG",
        method="ora",
        pvalue_cutoff=0.05
    )
    
    print("\nUp-regulated genes KEGG Pathway Enrichment:")
    if up_kegg_results.empty:
        print("No significant enrichment found")
    else:
        print(up_kegg_results)
        
        # Export results
        bio_interp.export_results(
            results=up_kegg_results,
            output_path="./exports/upregulated_kegg.csv",
            format="csv"
        )

# Run enrichment on down-regulated genes
if downregulated_genes:
    down_kegg_results = bio_interp.run_enrichment_analysis(
        gene_list=downregulated_genes,
        source="KEGG",
        method="ora",
        pvalue_cutoff=0.05
    )
    
    print("\nDown-regulated genes KEGG Pathway Enrichment:")
    if down_kegg_results.empty:
        print("No significant enrichment found")
    else:
        print(down_kegg_results)
        
        # Export results
        bio_interp.export_results(
            results=down_kegg_results,
            output_path="./exports/downregulated_kegg.csv",
            format="csv"
        )

print("\nExample analysis completed successfully!")
